generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  player
  admin
}

enum CatchType {
  farm
  trophy
  farm_trophy
}

enum ReportStatus {
  open
  resolved
  dismissed
}

model User {
  id            String    @id @default(cuid())
  nickname      String    @unique
  passwordHash  String
  role          Role      @default(player)
  disabledAt    DateTime?
  lastSeenAt    DateTime?
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())
  posts         Post[]
  comments      Comment[]
  favorites     Favorite[]
  reports       Report[]           @relation("Reporter")
  resolvedReports Report[]         @relation("ReportResolver")
  invitesCreated Invite[]          @relation("InviteCreator")
  inviteUsed    Invite?            @relation("InviteUsedBy")
  deletedPosts  Post[]             @relation("PostDeletedBy")
  deletedComments Comment[]        @relation("CommentDeletedBy")
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Favorite {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  postId       String?
  post         Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason       String
  status       ReportStatus @default(open)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model FishSpecies {
  id          String         @id @default(cuid())
  name        String         @unique
  waterbodies String[]
  posts       Post[]
}

model Waterbody {
  id               String           @id
  name             String
  metersPerCell    Float
  xMin             Float
  xMax             Float
  yMin             Float
  yMax             Float
  yFlipped         Boolean          @default(false)
  imageFile        String
  imageWidth       Int
  imageHeight      Int
  padLeft          Int
  padTop           Int
  padRight         Int
  padBottom        Int
  cellPx           Int
  rf4mapLocationId Int?
  sortOrder        Int
  sourceUrl        String?
  posts            Post[]
}

model Post {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  waterbodyId String
  waterbody   Waterbody     @relation(fields: [waterbodyId], references: [id])
  fishId      String
  fish        FishSpecies   @relation(fields: [fishId], references: [id])
  coordX      Float
  coordY      Float
  catchType   CatchType
  catchDate   DateTime
  comment     String        @default("")
  weightKg    Float?
  bait        String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?         @relation("PostDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  screenshots Screenshot[]
  comments    Comment[]
  favorites   Favorite[]
  reports     Report[]

  @@index([waterbodyId, createdAt])
  @@index([fishId])
  @@index([catchDate])
  @@index([userId])
  @@index([deletedAt])
}

model Comment {
  id          String        @id @default(cuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?         @relation("CommentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  screenshots Screenshot[]
  reports     Report[]

  @@index([postId, createdAt])
  @@index([deletedAt])
}

model Screenshot {
  id        String   @id @default(cuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  filename  String
  sortOrder Int      @default(0)
}

model GuideDataset {
  key       String   @id
  updatedAt DateTime @updatedAt
  rows      Json
}
