# Local `npm run dev` (without Docker). Copy to server/.env
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

DATABASE_URL="postgresql://rf4:CHANGE_ME@127.0.0.1:5432/rf4spots"
JWT_SECRET=
PORT=3780
HOST=127.0.0.1
ALLOW_REGISTER=true
TRUST_PROXY=0
REQUIRE_HTTPS=0
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Android-клиент (WebView) ходит с https://appassets.androidplatform.net — сервер добавляет этот origin сам.
NODE_ENV=development

# Beget S3 (private bucket + signed URLs). CORS: GET/HEAD for CORS_ORIGINS in Beget panel.
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_REGION=ru1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=3600
