{
  "name": "rf4-spots-client",
  "version": "1.0.0",
  "private": true,
  "description": "Клиент точек ловли Russian Fishing 4",
  "author": "RF4 Spots",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "node scripts/pack-win.cjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.rf4spots.app",
    "productName": "RF4 Spots",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
