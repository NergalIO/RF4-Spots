# Copy to .env next to docker-compose.yml (this file is not used as-is).
# Generate secrets: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

POSTGRES_USER=rf4
POSTGRES_PASSWORD=
# Avoid @ : / in the password — they break DATABASE_URL.
POSTGRES_DB=rf4spots

JWT_SECRET=

# true/false — open self-service signup. Use false on the public server.
ALLOW_REGISTER=true

# 1 when API sits behind Caddy/nginx
TRUST_PROXY=0

# 1 on the public server so /updates and the API refuse plain HTTP (except localhost)
REQUIRE_HTTPS=0

# Comma-separated browser origins. Electron has no Origin and is always allowed.
# Local Vite: http://127.0.0.1:5173,http://localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Caddy (--profile https): real DNS name, not a raw IP
DOMAIN=localhost
ACME_EMAIL=
